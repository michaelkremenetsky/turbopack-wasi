+# The host process bridge (src/host_pool.rs) registers napi callbacks so a
+# capable host can provide the child processes + loopback TCP the pool needs
+# (wasi itself has neither). Mirrors how 16.2's worker_pool takes napi deps.
+[target.'cfg(target_family = "wasm")'.dependencies]
+napi = { workspace = true }
+napi-derive = "2"
+
diff --git a/turbopack/crates/turbopack-node/src/host_pool.rs b/turbopack/crates/turbopack-node/src/host_pool.rs
new file mode 100644
