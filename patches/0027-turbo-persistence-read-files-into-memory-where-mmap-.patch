+use std::{fs::File, ops::Deref};
+
+/// A read-only view of a file's bytes.
+///
+/// Backed by an OS memory map (`memmap2`) on platforms that support it, and by
+/// an owned heap buffer on `wasm32-wasip1`, where `memmap2` has no backend and
+/// `Mmap::map` fails at runtime with "platform not supported" (which otherwise
+/// makes every snapshot commit fail and roll back, so nothing is ever
+/// persisted). Both variants deref to `&[u8]`, so the read paths are identical;
+/// the `madvise` hints are `#[cfg(unix)]` and simply absent on the owned path.
+///
+/// A boxed slice has a stable address for its whole lifetime, so the zero-copy
+/// `ArcBytes`/`RcBytes` `from_mmap` subslice invariants hold for the owned
+/// variant exactly as they do for a real mmap.
+#[allow(dead_code)] // one variant is unused per target (Owned off-wasi, Mmap on wasi target_os)
+pub enum FileMap {
+    Mmap(memmap2::Mmap),
+    Owned(Box<[u8]>),
+}
+
+impl FileMap {
+    /// Maps the entire file read-only, or on wasi reads it into an owned buffer.
+    ///
+    /// # Safety
+    ///
+    /// On the mmap path the file must not be modified for the lifetime of the
+    /// returned `FileMap` — the same contract as [`memmap2::Mmap::map`]. The
+    /// owned path has no such requirement (it copies eagerly).
+    pub unsafe fn map(file: &File) -> std::io::Result<FileMap> {
+        #[cfg(not(target_os = "wasi"))]
+        {
+            Ok(FileMap::Mmap(unsafe { memmap2::Mmap::map(file)? }))
+        }
+        #[cfg(target_os = "wasi")]
+        {
+            use std::io::Read;
+            let len = file.metadata()?.len() as usize;
+            let mut buf = Vec::with_capacity(len);
+            // `&File: Read`; callers open the file immediately before mapping, so
+            // the cursor is at the start. Reading from the shared reference keeps
+            // the caller's handle usable and avoids `try_clone`/`seek`, which are
+            // shakier on wasi.
+            let mut reader: &File = file;
+            reader.read_to_end(&mut buf)?;
+            Ok(FileMap::Owned(buf.into_boxed_slice()))
+        }
+    }
+
+    /// `madvise` hint for the whole map. No-op on the owned (wasi) path.
+    #[cfg(unix)]
+    pub fn advise(&self, advice: memmap2::Advice) -> std::io::Result<()> {
+        match self {
+            FileMap::Mmap(m) => m.advise(advice),
+            FileMap::Owned(_) => Ok(()),
+        }
+    }
+
+    /// `madvise` hint for a sub-range. No-op on the owned (wasi) path.
+    #[cfg(unix)]
+    pub fn advise_range(
+        &self,
+        advice: memmap2::Advice,
+        offset: usize,
+        len: usize,
+    ) -> std::io::Result<()> {
+        match self {
+            FileMap::Mmap(m) => m.advise_range(advice, offset, len),
+            FileMap::Owned(_) => Ok(()),
+        }
+    }
+}
+
+impl Deref for FileMap {
+    type Target = [u8];
+
+    fn deref(&self) -> &[u8] {
+        match self {
+            FileMap::Mmap(m) => m,
+            FileMap::Owned(b) => b,
+        }
+    }
+}
+
