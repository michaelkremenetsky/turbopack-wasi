@@ -0,0 +1,44 @@
+//! A no-op SWC plugin runtime for `wasm` host targets.
+//!
+//! SWC transform plugins are themselves WebAssembly modules, executed by an
+//! embedded wasm runtime (`swc_plugin_backend_wasmtime`, i.e. wasmtime). That
+//! backend cannot run inside a wasm guest, and it pulls in the
+//! `cap-std`/`wasi-common` stack, which does not build for
+//! `wasm32-wasip1-threads`. The transform pipeline still wants a plugin
+//! runtime to hand to swc, so on wasm we drop the wasmtime backend and swap the
+//! concrete `WasmtimeRuntime` for this stub.
+//!
+//! An app with no configured SWC plugins never reaches the point of executing
+//! one; actually running a plugin returns a clear error instead of silently
+//! doing nothing.
+
+use swc_core::plugin_runner::runtime::{Func, Instance, Module, ModuleCache, Runtime};
+
+#[derive(Debug)]
+pub struct NoopRuntime;
+
+impl Runtime for NoopRuntime {
+    fn identifier(&self) -> &'static str {
+        "noop-wasm (SWC wasm plugins unsupported on wasm host targets)"
+    }
+
+    fn prepare_module(&self, _bytes: &[u8]) -> anyhow::Result<ModuleCache> {
+        // Return an opaque placeholder so plugin-module construction succeeds;
+        // the failure is deferred to `init`, where a plugin would actually run.
+        Ok(ModuleCache(Box::new(())))
+    }
+
+    fn init(
+        &self,
+        _name: &str,
+        _imports: Vec<(String, Func)>,
+        _envs: Vec<(String, String)>,
+        _module: Module,
+    ) -> anyhow::Result<Box<dyn Instance>> {
+        anyhow::bail!("SWC wasm transform plugins are not supported on wasm host targets")
+    }
+
+    fn clone_cache(&self, _cache: &ModuleCache) -> Option<ModuleCache> {
+        Some(ModuleCache(Box::new(())))
+    }
+}
diff --git a/turbopack/crates/turbopack-ecmascript-plugins/Cargo.toml b/turbopack/crates/turbopack-ecmascript-plugins/Cargo.toml
