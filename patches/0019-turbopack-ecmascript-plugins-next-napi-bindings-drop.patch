@@ -41,7 +41,12 @@ swc_core = { workspace = true, features = [
   "__plugin_transform_host",
   "__plugin_transform_host_schema_v1",
 ] }
-swc_plugin_backend_wasmtime = { workspace = true }
 swc_emotion = { workspace = true }
 swc_relay = { workspace = true }
 
+# The wasmtime SWC-plugin backend can't run inside a wasm guest and pulls in
+# cap-std/wasi-common (which don't build for wasm32-wasip1-threads). On wasm we
+# swap it for a stub runtime (`wasm_noop_runtime`); everywhere else it's used.
+[target.'cfg(not(target_family = "wasm"))'.dependencies]
+swc_plugin_backend_wasmtime = { workspace = true }
+
