+/// Registers the host SWC-plugin driver for `swc-plugin-host-bridge`. The embedded wasmtime plugin
+/// backend can't run inside a wasm guest, so `experimental.swcPlugins` modules are executed by the
+/// embedder's own WebAssembly engine instead. The handler is invoked (fire-and-forget) with the
+/// address of a control block in the guest's shared linear memory; the JS driver worker then
+/// services that channel — instantiating the plugin and forwarding its host imports back to the
+/// guest's swc closures. See `docs/swc-plugin-host-bridge.md`. First registration wins.
+#[cfg(target_arch = "wasm32")]
+#[napi_derive::napi(ts_args_type = "handler: (channelAddr: number) => void")]
+pub fn init_swc_plugin_bridge(env: Env, handler: JsFunction) -> napi::Result<()> {
+    use napi::threadsafe_function::{ThreadsafeFunction, ThreadsafeFunctionCallMode};
+
+    let mut tsfn: ThreadsafeFunction<u32> = handler.create_threadsafe_function(0, |ctx| {
+        Ok(vec![ctx.env.create_uint32(ctx.value)?.into_unknown()])
+    })?;
+    // Don't keep the Node.js event loop alive for the bridge (matches the fetch bridge).
+    let _ = tsfn.unref(&env);
+
+    struct HostPluginBridge {
+        tsfn: ThreadsafeFunction<u32>,
+    }
+    impl swc_plugin_host_bridge::SwcPluginHost for HostPluginBridge {
+        fn signal(&self, channel_addr: u32) {
+            // Wake the driver worker to start servicing this channel. Non-blocking:
+            // the guest thread rendezvouses with the worker through the channel's
+            // atomics after this returns.
+            self.tsfn
+                .call(Ok(channel_addr), ThreadsafeFunctionCallMode::NonBlocking);
+        }
+    }
+
+    swc_plugin_host_bridge::set_swc_plugin_host(Box::new(HostPluginBridge { tsfn }));
+    Ok(())
+}
+
